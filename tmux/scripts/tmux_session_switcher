#!/bin/bash

# Get a list of all active tmux sessions
sessions=$(tmux list-sessions -F "#S")

NEW_ENTRY="[+] New session"

# Use fzf to select a session (or the "new session" entry)
selected_session=$( { echo "$NEW_ENTRY"; echo "$sessions"; } | fzf --reverse \
  --preview "[ {} = '$NEW_ENTRY' ] && echo 'Create a new session' || tmux list-windows -t {}")

# Create a new session if requested
if [ "$selected_session" = "$NEW_ENTRY" ]; then
  exec "$(dirname "$0")/tmux_new_session_popup"
fi

# Check if a session was selected
if [ -n "$selected_session" ]; then
  # Check if the script is running inside a tmux session
  if [ -n "$TMUX" ]; then
    # Use tmux switch-client to switch to the selected session
    tmux switch-client -t "$selected_session"
  else
    # Attach to the selected session
    tmux attach-session -t "$selected_session"
  fi
else
  echo "No session selected."
fi

